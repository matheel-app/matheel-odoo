<?xml version="1.0" encoding="utf-8"?>
<!-- ZATCA category and exemption code on the tax form. -->
<odoo>
    <record id="view_tax_form_matheel" model="ir.ui.view">
        <field name="name">account.tax.form.matheel</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <field name="amount_type" position="after">
                <field name="matheel_tax_category"/>
                <field name="matheel_exemption_code" invisible="matheel_tax_category in (False, 'S')"/>
            </field>
        </field>
    </record>
</odoo>
