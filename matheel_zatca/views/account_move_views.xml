<?xml version="1.0" encoding="utf-8"?>
<!-- The ZATCA status on invoices: a badge in the list, a status line and a send button on the form. -->
<odoo>
    <record id="view_move_form_matheel" model="ir.ui.view">
        <field name="name">account.move.form.matheel</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="invisible" add="matheel_state in ('reported', 'cleared')" separator=" or "/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_matheel_send" type="object" string="Send to ZATCA"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund') or matheel_state in ('reported', 'cleared', 'to_send')"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger mb-0" role="alert" invisible="matheel_state != 'error'">
                    <strong>ZATCA rejected this invoice | رفضت الهيئة الفاتورة: </strong>
                    <field name="matheel_message" class="oe_inline"/>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="ZATCA" name="matheel" invisible="not matheel_state">
                    <group>
                        <field name="matheel_state" widget="badge"/>
                        <field name="matheel_counter"/>
                        <field name="matheel_uuid"/>
                        <field name="matheel_message"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_matheel" model="ir.ui.view">
        <field name="name">account.move.tree.matheel</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="status_in_payment" position="before">
                <field name="matheel_state" widget="badge" optional="show"
                       decoration-success="matheel_state in ('reported', 'cleared')"
                       decoration-danger="matheel_state == 'error'" decoration-info="matheel_state == 'to_send'"/>
            </field>
        </field>
    </record>
</odoo>
