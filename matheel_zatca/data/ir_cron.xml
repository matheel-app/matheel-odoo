<?xml version="1.0" encoding="utf-8"?>
<!-- Files queued invoices with ZATCA; posting an invoice also triggers it at once. -->
<odoo noupdate="1">
    <record id="ir_cron_matheel_send" model="ir.cron">
        <field name="name">ZATCA (Matheel): file queued invoices</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_matheel_send()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
